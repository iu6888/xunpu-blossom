# 运行环境
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# 数据库文件位置（默认 data/xunpu.db）
# DB_FILE=./data/xunpu.db

# 管理后台账号（仅首次建库时生效，改这里不会改已存在的账号）
ADMIN_USER=admin
ADMIN_PASSWORD=xunpu2026
ADMIN_NAME=品牌主理人

# 会话有效期（小时）
SESSION_TTL_HOURS=168

# 订单规则：运费 12 元，满 299 元免运费（单位：分）
SHIPPING_FEE_FEN=1200
FREE_SHIPPING_FEN=29900

# 限流：每窗口总请求数 / 写请求数
RATE_WINDOW_MS=60000
RATE_MAX=120
RATE_WRITE_MAX=60

# 允许跨域的来源，逗号分隔。同源部署留空即可
# CORS_ORIGINS=https://xunpu.example.com

# 反向代理后需要信任 X-Forwarded-For 时开启
# TRUST_PROXY=1

# 生产环境建议关闭请求日志
# LOG_REQUESTS=0
