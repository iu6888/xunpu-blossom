# 统一换行符，避免 Windows 上编辑后 shell 脚本在 Linux 上跑不起来
* text=auto eol=lf

*.sh    text eol=lf
*.js    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
Dockerfile text eol=lf

# Windows 批处理必须是 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.db    binary
*.png   binary
*.jpg   binary
*.zip   binary
*.gz    binary
