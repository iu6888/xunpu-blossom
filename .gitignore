# 依赖
node_modules/

# 运行时数据：数据库、WAL 副本、备份
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/

# 便携包内置的 Node 运行时（体积大，不入库）
runtime/

# 本地环境变量
.env
.env.local

# 打包产物
*.tar.gz
*.zip

# 临时文件
.tmp/
*.log

# 系统文件
.DS_Store
Thumbs.db

# 背景音乐：体积大，且多为有版权素材，不入库
# 部署时 package.sh 仍会打包它，只是不提交到 git
assets/audio/*.mp3
assets/audio/*.m4a
assets/audio/*.ogg
assets/audio/*.wav
